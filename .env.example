# Copy to .env and fill in. NEVER commit .env.

# --- PayPal (SANDBOX ONLY) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID from the developer dashboard (needed for signature verification)
PAYPAL_WEBHOOK_ID=
# Sandbox merchant (payee) email — the "Bean & Brew Supply" business account
PAYPAL_MERCHANT_EMAIL=

# --- AI ---
ANTHROPIC_API_KEY=
# Model IDs are config, not code. Check current model names before setting.
AI_MODEL_AGENT=
AI_MODEL_JUDGE=

# --- Data ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/warrant

# --- Signing (Ed25519 private JWK, generated by `pnpm keys:generate`) ---
WARRANT_SIGNING_JWK=
WARRANT_AGENT_SIGNING_JWK=

# --- App ---
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# Hard ceiling on AI spend per mandate run (protects the hosted demo during judging)
AI_MAX_CALLS_PER_RUN=40

# --- Sponsor (start AG Grid trial ~Nov 1 so it covers judging to Dec 15) ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
