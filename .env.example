# Copy to .env and fill in. NEVER commit .env. Everything here is FREE-TIER (zero-cost rule, ADR 008).

# --- PayPal (SANDBOX ONLY) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID from the developer dashboard (needed for signature verification)
PAYPAL_WEBHOOK_ID=
# Sandbox merchant (payee) email — the "Bean Brew Supply" business account
PAYPAL_MERCHANT_EMAIL=

# --- AI (free tiers only) ---
# Order of providers to try. Supported: google, groq, fixture (recorded outputs, for tests/offline)
AI_PROVIDER_ORDER=google,groq
# Google AI Studio key (free tier, no card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq key (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=
# Model IDs are config. Check current free models: aistudio.google.com/rate-limit and console.groq.com/docs/rate-limits
AI_MODEL_GOOGLE_SMART=
AI_MODEL_GOOGLE_FAST=
AI_MODEL_GROQ=
# Self-imposed daily caps (keep BELOW the provider's free quota so the judging days never run dry)
AI_DAILY_CALL_CAP_GOOGLE=900
AI_DAILY_CALL_CAP_GROQ=700
# Hard ceiling on model calls per agent run (protects quota during judging)
AI_MAX_CALLS_PER_RUN=12

# --- Data (Neon free tier, no card) ---
# Pooled connection string for the app; direct (non-pooled) for migrations
DATABASE_URL=postgres://postgres:postgres@localhost:5432/warrant
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/warrant

# --- Signing (Ed25519 private JWKs, generated by `pnpm keys:generate`) ---
WARRANT_SYSTEM_SIGNING_JWK=
WARRANT_USER_SIGNING_JWK=
WARRANT_AGENT_SIGNING_JWK=

# --- App ---
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# Protects cron + admin routes (Vercel sends this as a Bearer token to cron routes)
CRON_SECRET=
# Per-IP limit on agent runs per hour on the hosted demo
RATE_LIMIT_AGENT_RUNS_PER_HOUR=10

# --- Sponsor (start the free AG Grid trial on Nov 1 so it covers judging to Dec 15) ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
